# Configuración del servidor Backend (compatible con TG-Backend en puerto 8080)
PORT=8080
BACKEND_PORT=8080

# PostgreSQL (en AWS, usar el endpoint privado de RDS)
DATABASE_URL=postgresql://course_app:<PASSWORD>@<HOST_PRIVADO>:5432/course_ecommerce_db
DB_SSL=true
DB_POOL_MAX=10
# Ruta al certificado CA oficial de RDS, montado como archivo en producción
DB_SSL_CA=

# Seguridad y credenciales
JWT_SECRET=<GENERAR_UN_SECRETO_ALEATORIO_LARGO>
ADMIN_EMAIL=admin@course.com
ADMIN_PASSWORD=<DEFINIR_CON_UN_GESTOR_DE_SECRETOS>
STRIPE_SECRET_KEY=

# URL base pública del frontend/ALB (para redirección de Stripe y CORS)
CLIENT_URL=https://<DOMINIO_DEL_FRONTEND>

# Solo para migrar datos desde MongoDB. Usuario de solo lectura recomendado.
MONGO_SOURCE_URI=mongodb://<USUARIO>:<PASSWORD>@<HOST_ORIGEN>:27017/course_ecommerce_db?authSource=admin
