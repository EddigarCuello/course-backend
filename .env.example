# Configuración del servidor Backend (compatible con TG-Backend en puerto 8080)
PORT=8080
BACKEND_PORT=8080

# Conexión a MongoDB (usar IP privada de la instancia de BD o endpoint DNS en la subred privada de DB)
MONGO_URI=mongodb://admin:ChangeMeStrongPassword@<IP_PRIVADA_MONGODB>:27017/course_ecommerce_db?authSource=admin

# Seguridad y credenciales
JWT_SECRET=tu_jwt_secret_super_seguro
ADMIN_EMAIL=admin@course.com
ADMIN_PASSWORD=admin123
STRIPE_SECRET_KEY=

# URL base pública del frontend/ALB (para redirección de Stripe y CORS)
CLIENT_URL=http://<DNS_DEL_ALB>
